# MinIO / S3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# Kafka
KAFKA_BROKERS=kafka:9093
KAFKA_SCHEMA_REGISTRY=http://schema-registry:8081

# PostgreSQL (Hive Metastore backend)
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=metastore

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# Trino
TRINO_HOST=trino
TRINO_PORT=8080

# Superset
SUPERSET_SECRET_KEY=12345ab@
SUPERSET_ADMIN_PASSWORD=admin

# Spark
SPARK_CONNECT_URL=sc://spark-connect:15002

# StarRocks
STARROCKS_HOST=starrocks-fe-0
STARROCKS_FE_QUERY_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_DB=gold

# Tika
TIKA_SERVER_JAR=http://tika-server:9998
DATAS_DIR=/opt/spark/work-dir/datas

# AI Models (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SUMMARIZER_MODEL=facebook/bart-large-cnn
CLASSIFIER_MODEL=cross-encoder/nli-MiniLM2-L6-H768
