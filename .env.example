# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# MinIO / S3 (object store interno — não altere em dev local)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# Kafka
KAFKA_BROKERS=kafka:9093
KAFKA_SCHEMA_REGISTRY=http://schema-registry:8081

# PostgreSQL (backend do Hive Metastore — não altere em dev local)
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=metastore

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# Trino
TRINO_HOST=trino
TRINO_PORT=8080

# Superset
SUPERSET_SECRET_KEY=troque-por-uma-chave-segura
SUPERSET_ADMIN_PASSWORD=admin

# Spark
SPARK_CONNECT_URL=sc://spark-connect:15002
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# StarRocks
STARROCKS_HOST=starrocks-fe-0
STARROCKS_FE_QUERY_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_DB=gold

# Tika
TIKA_SERVER_JAR=http://tika-server:9998
DATAS_DIR=/workspace/datas

# Modelos de IA (HuggingFace — baixados automaticamente na primeira execução)
# Embeddings em português — modelo especializado, melhor precisão para documentos PT-BR
EMBEDDING_MODEL=PORTULAN/serafim-100m-portuguese-pt-sentence-encoder
SUMMARIZER_MODEL=facebook/bart-large-cnn
CLASSIFIER_MODEL=cross-encoder/nli-MiniLM2-L6-H768
RAG_TOP_K=3
# Temperatura: 0.0 = determinístico/preciso | 1.0 = criativo (recomendado: 0.0–0.2 para RAG)
LLM_TEMPERATURE=0.1

# ─────────────────────────────────────────────────────────────
# LLM Provider — escolha UM dos três abaixo
# ─────────────────────────────────────────────────────────────
# Opções: openai | gemini | ollama
LLM_PROVIDER=ollama

# Ollama (sem custo — requer Ollama instalado no host: https://ollama.com)
LLM_MODEL=llama3.1
OLLAMA_URL=http://host.docker.internal:11434

# OpenAI (requer API key: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (requer API key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
